{
  "model": "gui-owl-1.5-8b",
  "input": "screenshot",
  "endpoint": {
    "base_url": "http://localhost:8080",
    "api_flavor": "proxy"
  },
  "dataset": {
    "path": "data/labels/ground-truth.jsonl",
    "annotation_origin": [
      "gpt-5.6"
    ],
    "images_dir": "data/images"
  },
  "description_indices": [
    0,
    1,
    2
  ],
  "prompt": {
    "style": "normalized"
  },
  "coordinates": {
    "format": "corner",
    "grid": 1000
  },
  "inference": {
    "max_tokens": 2048,
    "temperature": 0,
    "thinking_budget": -1,
    "max_image_dim": 0,
    "timeout": 120,
    "workers": 2
  },
  "metric": "centroid",
  "output_dir": "benchmark-results"
}
