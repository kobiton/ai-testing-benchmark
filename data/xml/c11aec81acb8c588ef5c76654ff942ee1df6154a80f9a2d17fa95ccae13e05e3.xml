                              <android.widget.TextView index="0" package="com.substack.app" class="android.widget.TextView" text="Toward the end, he spoke warmly of his wife and his children. And in that final moment it was as if he was already retreating from public life back into his private life. The tragedy of it all seemed to bear down upon him and he fought his way through tears." checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" long-clickable="false" password="false" scrollable="false" selected="false" bounds="[53,1890][1027,2106]" displayed="true" a11y-important="true" screen-reader-focusable="true" drawing-order="0" showing-hint="false" text-entry-key="false" dismissable="false" a11y-focused="false" heading="false" live-region="0" context-clickable="false" content-invalid="false" />
