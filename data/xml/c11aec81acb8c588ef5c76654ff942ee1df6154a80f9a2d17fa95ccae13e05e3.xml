                              <android.widget.TextView index="0" package="com.substack.app" class="android.widget.TextView" text="There was no joy to be found today. There was no satisfaction. Just frustration, and melancholy, and a profound sense of squandered opportunity." checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" long-clickable="false" password="false" scrollable="false" selected="false" bounds="[53,1004][1027,1198]" displayed="true" a11y-important="true" screen-reader-focusable="true" drawing-order="0" showing-hint="false" text-entry-key="false" dismissable="false" a11y-focused="false" heading="false" live-region="0" context-clickable="false" content-invalid="false" />
                            </android.view.View>
                            <android.view.View index="8" package="com.substack.app" class="android.view.View" text="" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" long-clickable="false" password="false" scrollable="false" selected="false" bounds="[53,1240][1027,1848]" displayed="true" a11y-important="true" screen-reader-focusable="false" drawing-order="8" showing-hint="false" text-entry-key="false" dismissable="false" a11y-focused="false" heading="false" live-region="0" context-clickable="false" content-invalid="false">
                              <android.widget.TextView index="0" package="com.substack.app" class="android.widget.TextView" text="As Keir Starmer gave his speech outside Downing Street, his voice finally began to break. He’d conducted himself with immense dignity. Instead of ruining his reputation through a long drawn-out battle, he would step down. He promised to provide for whatever timetable the party needed. He did the right thing - for the party, for the country, for himself and his successor." checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" long-clickable="false" password="false" scrollable="false" selected="false" bounds="[53,1240][1027,1848]" displayed="true" a11y-important="true" screen-reader-focusable="true" drawing-order="0" showing-hint="false" text-entry-key="false" dismissable="false" a11y-focused="false" heading="false" live-region="0" context-clickable="false" content-invalid="false" />
                            </android.view.View>
