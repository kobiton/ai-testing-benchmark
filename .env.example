# Copy to .env. Every value here can also be passed as a CLI flag, which wins.
#   cp .env.example .env

# ── Benchmark — the only two settings most people need ───────────────────────
# Base URL of any OpenAI-compatible server. /v1/chat/completions is appended.
#   vLLM        http://localhost:8000
#   llama.cpp   http://localhost:8080
#   Ollama      http://localhost:11434
#   OpenAI      https://api.openai.com
# (PROXY_URL is accepted as an alias, for scripts written against the older name.)
BASE_URL=http://localhost:8080

# Sent as BOTH `Authorization: Bearer <key>` and `X-API-Key: <key>`, because servers
# disagree about which one they read. Leave it EMPTY for a local server started without
# an API key — an empty value sends no auth header at all, which is what those want.
# (PROXY_API_KEY is accepted as an alias.)
API_KEY=

# ── Labelling pipeline — not needed to run the benchmark ─────────────────────
# Only read by run_pipeline.py, i.e. only when labelling your own screenshots.
# Which provider does the labelling: "claude" or "openai".
LLM_PROVIDER=claude

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Screenshots in flight at once. Each worker walks its screenshot's calls in sequence,
# so this is also the number of concurrent HTTP requests, not a multiple of it.
PIPELINE_WORKERS=15
