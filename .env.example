# Copy to .env. The benchmark reads this file from the project root.
#   cp .env.example .env
#
# A run is described by a JSON config (config/<track>/<model>.json): model, endpoint,
# dataset selection, phrasings, prompt, coordinates, inference limits. The one thing a
# config never holds is a credential — `endpoint.api_key_env` names the variable below
# that the key is read from, and the run refuses to start when it is unset.

# ── Keys named by the shipped configs ─────────────────────────────────────────
# config/vision/gpt-5-6-terra.json and config/xml/gpt-5-6-terra.json
OPENAI_API_KEY=
# config/vision/claude-opus-4-8.json and config/xml/claude-opus-4-8.json
ANTHROPIC_API_KEY=
# The self-hosted configs (qwen2-5-vl-7b, gui-owl-1-5-8b) name no variable: a local
# vLLM / llama.cpp / Ollama started without a key wants no auth header at all.

# ── Running without a config ──────────────────────────────────────────────────
# Flags fall back to these. Base URL of any OpenAI-compatible server; /v1/chat/completions
# is appended (/v1/messages under --api-flavor anthropic).
#   vLLM        http://localhost:8000
#   llama.cpp   http://localhost:8080
#   Ollama      http://localhost:11434
#   OpenAI      https://api.openai.com
# (PROXY_URL is accepted as an alias, for scripts written against the older name.)
BASE_URL=http://localhost:8080

# Sent as BOTH `Authorization: Bearer <key>` and `X-API-Key: <key>` on the default
# `proxy` flavor, because servers disagree about which one they read. Leave it EMPTY for
# a local server started without a key — an empty value sends no auth header at all.
# Deliberately NOT read from OPENAI_API_KEY: that would forward a hosted credential to
# whatever BASE_URL happens to point at. (PROXY_API_KEY is accepted as an alias.)
API_KEY=

# The run's working directory decides where data/, config/ and benchmark-results/ are:
# the nearest directory at or above it holding this project's pyproject.toml. Set this
# to run from somewhere else.
# AI_TESTING_BENCHMARK_ROOT=/path/to/ai-testing-benchmark

# ── Labelling pipeline — not needed to run the benchmark ─────────────────────
# Only read by `ai-testing-benchmark pipeline`, i.e. only when labelling your own
# screenshots. Which provider does the labelling: "claude" or "openai".
LLM_PROVIDER=claude

ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_MODEL=gpt-4o

# Screenshots in flight at once. Each worker walks its screenshot's calls in sequence,
# so this is also the number of concurrent HTTP requests, not a multiple of it.
PIPELINE_WORKERS=15
